# Copy to .env.local and fill in. Never commit .env.local.

# Clerk dashboard -> Configure -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase dashboard -> Project settings -> API keys / Data API
NEXT_PUBLIC_SUPABASE_URL=
# the publishable key (sb_publishable_...) or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: set to true once Google has custom OAuth credentials in Clerk
NEXT_PUBLIC_GOOGLE_ONE_TAP=false
